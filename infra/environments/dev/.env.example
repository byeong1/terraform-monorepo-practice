# AWS 인증
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Terraform 변수 (민감한 값)
TF_VAR_my_ip=YOUR_IP/32
TF_VAR_db_password=CHANGE_ME
TF_VAR_db_username=admin
TF_VAR_db_name=appdb
TF_VAR_callback_secret=CHANGE_ME
TF_VAR_public_key_path=~/.ssh/your_key.pub
TF_VAR_private_key_path=~/.ssh/your_key
